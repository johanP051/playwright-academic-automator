# ==============================================================================
# 🔐 CONFIGURACIÓN DE PORTALES EDUCATIVOS Y PLATAFORMAS (PLAYWRIGHT AUTOMATOR)
# ==============================================================================
# NOTA: Nunca agregues contraseñas reales ni subas este archivo renombrado (.env) a Git.
#
# URL base de tu institución o plataforma (personalizable)
MOODLE_BASE_URL="https://pregrado.ucundinamarca.edu.co"
SAC_BASE_URL="https://sac.ucundinamarca.edu.co"
UDEMY_BASE_URL="https://www.udemy.com"
WOKWI_BASE_URL="https://wokwi.com"

# Rutas de almacenamiento de sesiones persistentes (Playwright storage_state)
MOODLE_AUTH_STATE="sessions/moodle_auth.json"
SAC_AUTH_STATE="sessions/sac_auth.json"
UDEMY_AUTH_STATE="sessions/udemy_auth.json"
WOKWI_AUTH_STATE="sessions/wokwi_auth.json"

# Opciones del navegador Playwright (True para modo silencioso/headless, False para ver la ventana)
HEADLESS_MODE=False
BROWSER_TIMEOUT_MS=30000
SLOW_MO_MS=100
